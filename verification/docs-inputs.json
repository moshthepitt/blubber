    {
      "id": "fuzz.cargo_fuzz.version",
      "unit": "version",
      "source": "scripts/reproduce.sh",
      "selector": "\\A(?s:.*?)require_version 'cargo-fuzz (?P<value>[\\d.]+)' cargo fuzz",
      "field": "value"
    },
    {
      "id": "fuzz.history.command_bytes",
      "unit": "bytes",
      "source": "fuzz/src/edits.rs",
      "selector": "^        \\.as_chunks::<(?P<value>\\d+)>\\(\\)$",
      "field": "value"
    },
    {
      "id": "fuzz.history.commands",
      "unit": "commands",
      "source": "fuzz/src/edits.rs",
      "selector": "^        \\.take\\((?P<value>\\d+)\\)$",
      "field": "value"
    },
    {
      "id": "fuzz.host.initial_bytes",
      "unit": "bytes",
      "source": "fuzz/src/edits.rs",
      "selector": "^const MAX_STORAGE: usize = (?P<value>\\d+);",
      "field": "value"
    },
    {
      "id": "fuzz.host.iteration_items",
      "unit": "items",
      "source": "fuzz/src/validation.rs",
      "selector": "S::visit\\(value, &mut (?P<value>\\d+)\\);",
      "field": "value"
    },
    {
      "id": "fuzz.host.rust_nightly",
      "unit": "toolchain",
      "source": "scripts/reproduce.sh",
      "selector": "^                export RUSTUP_TOOLCHAIN=(?P<value>nightly-[\\d-]+)$",
      "field": "value"
    },
    {
      "id": "fuzz.host.schemas",
      "unit": "schemas",
      "source": "fuzz/src/lib.rs",
      "selector": "^const SCHEMAS: usize = (?P<value>\\d+);",
      "field": "value"
    },
    {
      "id": "fuzz.libfuzzer_sys.version",
      "unit": "version",
      "source": "fuzz/Cargo.toml",
      "selector": "^libfuzzer-sys = \"(?P<value>[\\d.]+)\"$",
      "field": "value"
    },
    {
      "id": "fuzz.sdk.iteration_items",
      "unit": "items",
      "source": "programs/policy/src/corrupt.rs",
      "selector": "let mut iter = root\\.try_fixed\\(\\)\\?\\.try_iter\\(\\);\\n[^\\n]+\\n\\s*for _ in 0\\.\\.(?P<value>\\d+) \\{",
      "field": "value"
    },
    {
      "id": "fuzz.sdk.rust_version",
      "unit": "version",
      "source": "scripts/reproduce.sh",
      "selector": "^                export RUSTUP_TOOLCHAIN=(?P<value>[\\d.]+)$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.host.rss_mb",
      "unit": "MB",
      "source": "scripts/reproduce.sh",
      "selector": "^                seed=34\\n                rss=(?P<value>\\d+)$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.host.seed",
      "unit": "seed",
      "source": "scripts/reproduce.sh",
      "selector": "^                seed=(?P<value>\\d+)\\n                rss=2048$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.input_bytes",
      "unit": "bytes",
      "source": "scripts/reproduce.sh",
      "selector": "-max_len=(?P<value>\\d+) -seed=",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.sdk.rss_mb",
      "unit": "MB",
      "source": "scripts/reproduce.sh",
      "selector": "^                seed=217\\n                rss=(?P<value>\\d+)$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.sdk.seed",
      "unit": "seed",
      "source": "scripts/reproduce.sh",
      "selector": "^                seed=(?P<value>\\d+)\\n                rss=4096$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.time_seconds",
      "unit": "seconds",
      "source": "scripts/reproduce.sh",
      "selector": "^        seconds=(?P<value>\\d+)$",
      "field": "value"
    },
    {
      "id": "fuzz.wrapper.timeout_seconds",
      "unit": "seconds",
      "source": "scripts/reproduce.sh",
      "selector": "-timeout=(?P<value>\\d+) -rss_limit_mb=",
